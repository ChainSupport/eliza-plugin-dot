# Test environment variables template for Vitest
# Copy this file to vitest.env and fill in your actual values

# Polkadot Asset Hub RPC URL
ASSETHUB_RPC_URL=https://rpc-asset-hub-polkadot.luckyfriday.io

# Test account private keys (for testing purposes only)
# WARNING: These are test keys. Do not use real private keys in this file.
ALICE_PRIVATE_KEY=your_alice_private_key_here
BOB_PRIVATE_KEY=your_bob_private_key_here

# Subscan API Key for testing
SUBSCAN_API_KEY=your_subscan_api_key_here

